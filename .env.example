# ============================================================
# AM Collection — environment settings (copy this file to ".env")
#   cp .env.example .env
# Phir apni asal values bharein. .env file KABHI kisi ko na bhejein,
# GitHub par upload na karein — is mein secret keys hoti hain.
# ============================================================

# Server port (hosting aksar khud PORT de deti hai — wahan ye change na karein)
# Render par PORT Render khud deta hai; server.js process.env.PORT par hi
# bind hota hai, is liye Render ke Environment mein PORT set NA karein.
PORT=4000

# PostgreSQL connection string — apni hosting ke database se milegi
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
# Render par ye render.yaml se khud set ho jati hai (Blueprint database se
# linked) — Render ke Environment mein haath se likhne ki zaroorat nahi.
DATABASE_URL=postgres://user:password@localhost:5432/am_collection

# SSL: cloud database (Neon / Supabase / Railway / Render waghera) par true,
# local par false. Render ki DATABASE_URL (render.com) par server SSL khud
# bhi on kar leta hai — Render par isay true hi rakhein.
PGSSL=false

# JWT secret — login tokens ke liye. Lambi random value rakhein, kisi ko na batayein
JWT_SECRET=change-this-to-a-long-random-secret
# ============================================================
# ADMIN DASHBOARD LOGIN — sirf owner / admin ke liye
# Owner website ke AAM Login screen (Account -> Login) par yehi
# username/password dalta hai to Admin Dashboard khud khul jata
# hai — link mein #/admin ya /admin likhna NAHI padta. /admin
# page bhi fallback ke tor par inhi credentials se khulta hai.
# Storefront (customer side) par admin ka koi visible link NAHI
# hai, aur baghair is login ke dashboard ka koi data load NAHI hota.
# ⚠️ YE INITIAL / TEMPORARY CREDENTIALS HAIN — website LIVE
# karne se PEHLE ADMIN_PASSWORD lazmi change karein (aur
# ADMIN_USER bhi apna rakhein), phir server restart karein.
# ============================================================
ADMIN_USER=admin
ADMIN_PASSWORD=AM-Admin-786


# Apni website ke domain(s) — comma se alag karein
CORS_ORIGINS=http://localhost:4000,https://your-domain.example

# Delivery defaults (owner inhein badal sakta hai)
DELIVERY_BASE=200
DELIVERY_FREE_ABOVE=5000
STORE_CITY=Bahawalnagar

# Website par dikhne wala payment number (Easypaisa / JazzCash / NayaPay)
STORE_PAYMENT_NUMBER=03147656328

# Payment gateway secret keys — SIRF merchant approval ke baad provider dega.
# Ye values sirf server par rakhein, frontend mein kabhi nahi.
JAZZCASH_SECRET=
EASYPAISA_SECRET=
NAYAPAY_SECRET=

# ============================================================
# WHATSAPP ORDER NOTIFICATION (OPTIONAL — owner ke liye)
# Naya order ate hi owner ko WhatsApp par foran khabar jati hai.
# Ye TAB active hoti hai jab ye teen values bhari hon — warna
# notification khamoshi se skip ho jati hai aur orders bilkul
# aam tareeqe se chalte rehte hain.
# Values Meta WhatsApp Cloud API se milti hain (Meta for
# Developers -> apni app -> WhatsApp -> API Setup):
#   WHATSAPP_PHONE_NUMBER_ID — sender number ki ID (number nahi, ID)
#   WHATSAPP_ACCESS_TOKEN    — API token (secret — kisi ko na dein)
#   WHATSAPP_NOTIFY_TO       — owner ka apna WhatsApp number jis par
#                              khabar ani hai, country code ke saath
#                              (misaal: 923147656328) — ye number sirf
#                              notification RECEIVE karta hai, sender
#                              kabhi ye wala number NA rakhein.
#   WHATSAPP_TEMPLATE_NAME   — Meta par approved template ka naam.
#                              Template ke {{1}}..{{5}} = order number,
#                              customer name, customer phone, total
#                              (Rs.), payment method. Asal istemal ke
#                              liye template lazmi hai — baghair template
#                              plain text sirf tab deliver hota hai jab
#                              owner ne pichle 24 ghante mein sender
#                              number par message kiya ho.
#   WHATSAPP_TEMPLATE_LANG   — template ki language code (default en)
# ============================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
